<!DOCTYPE html>
<html lang="th" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Space Mission: ภารกิจพิชิตจักรวาลทางช้างเผือก</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cosmic: {
                            900: '#030712',
                            800: '#0b132b',
                            700: '#1c2541',
                            accent: '#38bdf8',
                            purple: '#a855f7',
                            gold: '#fbbf24',
                            danger: '#ef4444'
                        }
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 2s infinite alternate',
                        'float': 'float 4s ease-in-out infinite',
                        'twinkle': 'twinkle 3s infinite ease-in-out'
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%': { boxShadow: '0 0 10px rgba(56, 189, 248, 0.4)' },
                            '100%': { boxShadow: '0 0 25px rgba(168, 85, 247, 0.8)' }
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
                            '50%': { transform: 'translateY(-12px) rotate(3deg)' }
                        },
                        twinkle: {
                            '0%, 100%': { opacity: 0.3 },
                            '50%': { opacity: 1 }
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700&family=Orbitron:wght@500;700;900&display=swap');

        body {
            font-family: 'Kanit', sans-serif;
            background-color: #030712;
            color: #f3f4f6;
            touch-action: manipulation;
            user-select: none;
            -webkit-user-select: none;
            overflow-x: hidden;
        }

        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        /* Glassmorphism styling */
        .glass-panel {
            background: rgba(11, 19, 43, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.25);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
        }

        .glass-card {
            background: rgba(28, 37, 65, 0.65);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.2s ease-in-out;
        }

        .glass-card:hover {
            border-color: rgba(56, 189, 248, 0.6);
            transform: translateY(-2px);
        }

        /* Drag & Drop Visual Styles */
        .draggable-item {
            cursor: grab;
            touch-action: none;
        }

        .draggable-item:active {
            cursor: grabbing;
        }

        .dragging-ghost {
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.9;
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(56, 189, 248, 0.5);
            transition: none !important;
        }

        .drop-zone {
            transition: all 0.2s ease;
        }

        .drop-zone.drag-over {
            border-color: #38bdf8 !important;
            background-color: rgba(56, 189, 248, 0.2) !important;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.5);
        }

        /* Heart energy cell animation */
        .heart-cell {
            transition: transform 0.3s ease, filter 0.3s ease;
        }
        .heart-cell.lost {
            filter: grayscale(100%) opacity(30%);
            transform: scale(0.8);
        }

        /* Screen Shake for Errors */
        .shake-screen {
            animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes shake {
            10%, 90% { transform: translate3d(-2px, 0, 0); }
            20%, 80% { transform: translate3d(4px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
            40%, 60% { transform: translate3d(6px, 0, 0); }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #030712;
        }
        ::-webkit-scrollbar-thumb {
            background: #1c2541;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #38bdf8;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between relative overflow-hidden select-none">

    <!-- Background Canvas for Interactive Space Stars -->
    <canvas id="space-bg" class="fixed inset-0 w-full h-full pointer-events-none z-0"></canvas>

    <!-- Floating Astronaut Visual Decor -->
    <div class="fixed top-12 right-6 w-16 h-16 md:w-24 md:h-24 pointer-events-none z-0 opacity-40 animate-float hidden md:block">
        <svg viewBox="0 0 100 100" class="w-full h-full text-cyan-400">
            <path fill="currentColor" d="M50,10 A25,25 0 0,1 75,35 C75,50 65,60 50,60 C35,60 25,50 25,35 A25,25 0 0,1 50,10 Z" />
            <ellipse cx="50" cy="32" rx="15" ry="10" fill="#030712" />
            <path fill="#38bdf8" d="M40,28 Q50,22 60,28 Q50,38 40,28 Z" opacity="0.8"/>
            <rect x="35" y="60" width="30" height="30" rx="8" fill="currentColor" />
            <circle cx="50" cy="75" r="5" fill="#a855f7" />
        </svg>
    </div>

    <!-- MAIN APP CONTAINER -->
    <div class="relative z-10 w-full max-w-6xl mx-auto px-3 py-3 flex-1 flex flex-col min-h-screen">

        <!-- HEADER / NAVIGATION BAR -->
        <header class="w-full glass-panel rounded-2xl px-4 py-3 mb-3 flex items-center justify-between shadow-lg border-cyan-500/30">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-purple-600 flex items-center justify-center shadow-lg shadow-cyan-500/30">
                    <span class="text-xl">🚀</span>
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-bold font-orbitron bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-sky-200 to-purple-400">
                        SPACE MISSION
                    </h1>
                    <p class="text-xs text-slate-400 hidden sm:block" id="sub-title-text">
                        ภารกิจพิชิตจักรวาลทางช้างเผือก (ม.ปลาย)
                    </p>
                </div>
            </div>

            <!-- Global Controls: Mute & Language Toggle -->
            <div class="flex items-center space-x-2 md:space-x-3">
                <!-- High Score Badge -->
                <div class="hidden sm:flex items-center space-x-1 px-3 py-1 rounded-lg bg-slate-900/80 border border-amber-500/40 text-amber-300 text-xs font-semibold">
                    <span>🏆</span>
                    <span id="label-top-score">Top:</span>
                    <span id="hud-high-score" class="font-orbitron font-bold">0</span>
                </div>

                <!-- Language Toggle Button -->
                <button id="btn-lang" onclick="toggleLanguage()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs font-bold text-cyan-300 transition-all flex items-center space-x-1">
                    <span>🌐</span>
                    <span id="lang-code-text">TH / EN</span>
                </button>

                <!-- Sound Toggle Button -->
                <button id="btn-sound" onclick="toggleSound()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 flex items-center justify-center text-lg transition-all" title="Toggle Sound">
                    <span id="sound-icon">🔊</span>
                </button>
            </div>
        </header>

        <!-- GAME HUD (VISIBLE DURING GAMEPLAY) -->
        <div id="game-hud" class="hidden w-full glass-panel rounded-2xl p-3 mb-3 grid grid-cols-2 md:grid-cols-4 gap-3 items-center text-sm shadow-md">
            <!-- Hearts / Energy Cells -->
            <div class="flex items-center space-x-2 bg-slate-900/60 px-3 py-2 rounded-xl border border-rose-500/30">
                <span class="text-xs text-slate-400 font-semibold uppercase" id="hud-energy-label">พลังงาน:</span>
                <div class="flex space-x-1" id="hearts-container">
                    <span class="heart-cell text-lg">❤️</span>
                    <span class="heart-cell text-lg">❤️</span>
                    <span class="heart-cell text-lg">❤️</span>
                </div>
            </div>

            <!-- Timer Display -->
            <div class="flex items-center justify-between bg-slate-900/60 px-3 py-2 rounded-xl border border-cyan-500/30">
                <span class="text-xs text-slate-400 font-semibold uppercase" id="hud-timer-label">เวลา:</span>
                <div class="flex items-center space-x-2">
                    <span class="text-base">⏳</span>
                    <span id="hud-timer" class="font-orbitron font-bold text-lg text-cyan-400">60s</span>
                </div>
            </div>

            <!-- Score Display -->
            <div class="flex items-center justify-between bg-slate-900/60 px-3 py-2 rounded-xl border border-purple-500/30">
                <span class="text-xs text-slate-400 font-semibold uppercase" id="hud-score-label">คะแนน:</span>
                <div class="flex items-center space-x-1">
                    <span class="text-base text-amber-400">⭐</span>
                    <span id="hud-score" class="font-orbitron font-bold text-lg text-amber-300">0</span>
                </div>
            </div>

            <!-- Stage Stepper & Restart -->
            <div class="flex items-center justify-between space-x-2 bg-slate-900/60 px-3 py-2 rounded-xl border border-slate-700">
                <div class="flex-1">
                    <div class="flex justify-between text-xs text-slate-300 font-semibold mb-1">
                        <span id="hud-stage-label">ด่าน</span>
                        <span id="hud-stage-num" class="font-orbitron text-cyan-300">1 / 3</span>
                    </div>
                    <!-- Overall Progress Bar -->
                    <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden border border-slate-700">
                        <div id="hud-progress-bar" class="bg-gradient-to-r from-cyan-500 to-purple-500 h-full w-0 transition-all duration-300"></div>
                    </div>
                </div>
                <button onclick="restartCurrentGame()" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition" title="Restart Level">
                    🔄
                </button>
            </div>
        </div>

        <!-- SCREEN 1: START SCREEN -->
        <div id="screen-start" class="flex-1 flex flex-col items-center justify-center glass-panel rounded-3xl p-6 md:p-10 text-center relative overflow-hidden my-auto shadow-2xl border-cyan-500/40">
            <!-- Decorative Orbiting Circle -->
            <div class="absolute w-80 h-80 rounded-full border border-cyan-500/10 animate-spin opacity-50 pointer-events-none" style="animation-duration: 25s;"></div>
            <div class="absolute w-96 h-96 rounded-full border border-purple-500/10 animate-spin opacity-30 pointer-events-none" style="animation-duration: 40s; animation-direction: reverse;"></div>

            <div class="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
                <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 text-xs font-semibold mb-4 animate-bounce">
                    <span>🛸</span>
                    <span id="badge-target">แบบทดสอบดาราศาสตร์ ม.ปลาย</span>
                </div>

                <h2 class="text-2xl md:text-4xl font-extrabold font-orbitron text-white mb-3 tracking-wide leading-tight">
                    <span id="start-title-prefix">SPACE MISSION</span> <br class="hidden sm:inline">
                    <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-sky-300 to-purple-400" id="start-title-main">
                        ภารกิจพิชิตจักรวาลทางช้างเผือก
                    </span>
                </h2>

                <p class="text-sm md:text-base text-slate-300 mb-6 leading-relaxed max-w-xl" id="start-description">
                    สวมบทบาทเป็นนักดาราศาสตร์รุ่นใหม่ ออกสำรวจระบบสุริยะ จำแนกวัตถุท้องฟ้า และถอดรหัสความลับของทางช้างเผือกผ่านปริศนาลากวาง!
                </p>

                <!-- Rules Box -->
                <div class="w-full bg-slate-900/80 rounded-2xl p-4 border border-slate-700 mb-6 text-left text-xs md:text-sm space-y-2">
                    <div class="font-bold text-cyan-300 flex items-center space-x-2 border-b border-slate-800 pb-2">
                        <span>📜</span>
                        <span id="rules-header">กฎการปฏิบัติภารกิจ:</span>
                    </div>
                    <ul class="space-y-1.5 text-slate-300 list-disc list-inside">
                        <li id="rule-1">ไขปริศนาลากและวาง 3 ด่าน: ระบบสุริยะ, การจำแนกวัตถุท้องฟ้า และทางช้างเผือก</li>
                        <li id="rule-2">มีเวลาปฏิบัติภารกิจ <b>60 วินาที</b> และพลังงานสำรอง <b>3 หัวใจ</b></li>
                        <li id="rule-3">หากตอบผิดจะเสีย 1 หัวใจ / ต้องทำคะแนนแม่นยำอย่างน้อย <b>80%</b> เพื่อผ่านการทดสอบ</li>
                    </ul>
                </div>

                <!-- Action Button -->
                <button id="btn-start-game" onclick="startGame()" class="w-full sm:w-auto px-10 py-4 rounded-2xl bg-gradient-to-r from-cyan-500 via-sky-500 to-purple-600 hover:from-cyan-400 hover:to-purple-500 text-white font-orbitron font-bold text-lg shadow-xl shadow-cyan-500/25 hover:shadow-cyan-500/40 transform hover:-translate-y-1 active:translate-y-0 transition-all flex items-center justify-center space-x-3 group">
                    <span>🚀</span>
                    <span id="btn-start-text">เริ่มภารกิจอวกาศ</span>
                    <span class="group-hover:translate-x-1 transition-transform">➔</span>
                </button>
            </div>
        </div>

        <!-- SCREEN 2: GAMEPLAY CONTAINER -->
        <main id="screen-gameplay" class="hidden flex-1 flex flex-col justify-between glass-panel rounded-3xl p-4 md:p-6 mb-2 relative overflow-hidden">

            <!-- Stage Header Banner -->
            <div class="w-full flex flex-col sm:flex-row sm:items-center justify-between pb-3 mb-4 border-b border-slate-700/60 gap-2">
                <div>
                    <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider font-orbitron" id="stage-badge">STAGE 1</span>
                    <h3 class="text-lg md:text-xl font-bold text-white flex items-center space-x-2" id="stage-title">
                        <span>🪐</span> <span>ลำดับวงโคจรดาวเคราะห์ในระบบสุริยะ</span>
                    </h3>
                </div>
                <div class="text-xs text-slate-300 bg-slate-900/70 px-3 py-1.5 rounded-xl border border-slate-700" id="stage-instruction">
                    ลากดาวเคราะห์ไปวางในตำแหน่งวงโคจรที่ถูกต้องจากใกล้ดวงอาทิตย์ที่สุดไปไกลที่สุด
                </div>
            </div>

            <!-- STAGE 1 PUZZLE: PLANETARY ORBIT ORDERING -->
            <div id="stage-1-view" class="stage-view flex-1 flex flex-col justify-between space-y-4">
                <!-- Drop Slots Orbit Track -->
                <div class="w-full bg-slate-950/70 rounded-2xl p-4 border border-slate-800 overflow-x-auto">
                    <div class="text-xs text-cyan-400 font-semibold mb-2 flex items-center space-x-2">
                        <span>☀️</span>
                        <span id="solar-track-label">ดวงอาทิตย์ (จุดศูนย์กลาง) ➔ เรียงลำดับจากด้านในออกสู่ด้านนอก</span>
                    </div>
                    <div class="flex items-center space-x-2 min-w-[700px] justify-between py-2" id="s1-orbit-slots">
                        <!-- Orbit slots 1 to 8 will be dynamically rendered here -->
                    </div>
                </div>

                <!-- Draggable Planets Dock -->
                <div class="w-full bg-slate-900/90 rounded-2xl p-4 border border-cyan-500/30">
                    <div class="text-xs text-slate-400 font-semibold mb-3 flex items-center justify-between">
                        <span id="s1-dock-label">คลังดาวเคราะห์ (ลากไปวางในช่องวงโคจรข้างบน):</span>
                        <span class="text-cyan-400 text-xs" id="s1-remaining-count">เหลือ 8 ดาว</span>
                    </div>
                    <div id="s1-planets-dock" class="grid grid-cols-4 sm:grid-cols-8 gap-2 md:gap-3 min-h-[90px] items-center justify-items-center">
                        <!-- Planet items generated dynamically -->
                    </div>
                </div>
            </div>

            <!-- STAGE 2 PUZZLE: COSMIC CLASSIFICATION -->
            <div id="stage-2-view" class="stage-view hidden flex-1 flex flex-col space-y-4">
                <!-- Drop Category Bins -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 flex-1" id="s2-categories-container">
                    <!-- Category 1: Stars -->
                    <div class="drop-zone bg-slate-950/80 rounded-2xl p-3 border-2 border-dashed border-amber-500/40 flex flex-col h-full min-h-[160px]" data-category="star">
                        <div class="flex items-center space-x-2 border-b border-amber-500/20 pb-2 mb-2">
                            <span class="text-xl">🌟</span>
                            <span class="font-bold text-amber-300 text-sm" id="cat-stars-title">ดาวฤกษ์ (Stars)</span>
                        </div>
                        <div class="s2-bin-items flex-1 flex flex-wrap gap-2 content-start p-1" id="bin-star"></div>
                    </div>

                    <!-- Category 2: Planets -->
                    <div class="drop-zone bg-slate-950/80 rounded-2xl p-3 border-2 border-dashed border-cyan-500/40 flex flex-col h-full min-h-[160px]" data-category="planet">
                        <div class="flex items-center space-x-2 border-b border-cyan-500/20 pb-2 mb-2">
                            <span class="text-xl">🪐</span>
                            <span class="font-bold text-cyan-300 text-sm" id="cat-planets-title">ดาวเคราะห์ (Planets)</span>
                        </div>
                        <div class="s2-bin-items flex-1 flex flex-wrap gap-2 content-start p-1" id="bin-planet"></div>
                    </div>

                    <!-- Category 3: Galaxies & Deep Space -->
                    <div class="drop-zone bg-slate-950/80 rounded-2xl p-3 border-2 border-dashed border-purple-500/40 flex flex-col h-full min-h-[160px]" data-category="deepspace">
                        <div class="flex items-center space-x-2 border-b border-purple-500/20 pb-2 mb-2">
                            <span class="text-xl">🌌</span>
                            <span class="font-bold text-purple-300 text-sm" id="cat-galaxy-title">กาแล็กซี & ห้วงอวกาศ</span>
                        </div>
                        <div class="s2-bin-items flex-1 flex flex-wrap gap-2 content-start p-1" id="bin-deepspace"></div>
                    </div>
                </div>

                <!-- Draggable Celestial Dock -->
                <div class="w-full bg-slate-900/90 rounded-2xl p-3 border border-cyan-500/30">
                    <div class="text-xs text-slate-400 font-semibold mb-2" id="s2-dock-label">
                        ลากวัตถุท้องฟ้าลงในหมวดหมู่ทางดาราศาสตร์ที่ถูกต้อง:
                    </div>
                    <div id="s2-items-dock" class="flex flex-wrap gap-2 min-h-[70px] items-center justify-center">
                        <!-- Stage 2 cards generated dynamically -->
                    </div>
                </div>
            </div>

            <!-- STAGE 3 PUZZLE: MILKY WAY & CONCEPT MATCHING -->
            <div id="stage-3-view" class="stage-view hidden flex-1 flex flex-col space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 flex-1">
                    <!-- Astronomy Facts / Descriptions List -->
                    <div class="space-y-2.5 overflow-y-auto max-h-[300px] md:max-h-none pr-1" id="s3-target-slots">
                        <!-- Concept target drop slots generated dynamically -->
                    </div>

                    <!-- Draggable Terms / Names Dock -->
                    <div class="bg-slate-950/80 rounded-2xl p-4 border border-cyan-500/30 flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold text-cyan-300 mb-2 flex items-center space-x-2">
                                <span>🧩</span>
                                <span id="s3-dock-title">คำศัพท์ดาราศาสตร์ทางช้างเผือก</span>
                            </div>
                            <p class="text-xs text-slate-400 mb-3" id="s3-dock-desc">
                                จับคู่คำศัพท์ลงในช่องคำอธิบายปรากฏการณ์ให้ถูกต้องตามหลักดาราศาสตร์ ม.ปลาย
                            </p>
                            <div id="s3-terms-dock" class="flex flex-wrap gap-2 min-h-[120px] items-start content-start">
                                <!-- Stage 3 terms generated dynamically -->
                            </div>
                        </div>
                        <div class="text-xs text-slate-500 italic mt-2 text-center" id="s3-tip">
                            💡 ข้อแนะนำ: ตรวจสอบคุณสมบัติของทางช้างเผือกและเนบิวลาให้ถี่ถ้วน
                        </div>
                    </div>
                </div>
            </div>

        </main>

        <!-- SCREEN 3: RESULTS / SUMMARY OVERLAY -->
        <div id="screen-summary" class="hidden flex-1 flex flex-col items-center justify-center glass-panel rounded-3xl p-6 md:p-8 text-center my-auto shadow-2xl border-cyan-500/40 relative z-20">
            <div class="max-w-xl w-full mx-auto flex flex-col items-center">
                
                <!-- Win/Loss Banner Icon -->
                <div id="summary-icon-wrapper" class="w-20 h-20 rounded-3xl bg-gradient-to-br from-cyan-400 to-purple-600 flex items-center justify-center text-4xl shadow-xl mb-3 animate-bounce">
                    🏆
                </div>

                <!-- Status Header -->
                <h2 id="summary-status-title" class="text-2xl md:text-3xl font-extrabold font-orbitron text-white mb-1">
                    MISSION ACCOMPLISHED!
                </h2>
                <p id="summary-status-subtitle" class="text-sm text-cyan-300 font-semibold mb-5">
                    ภารกิจสำเร็จ: คุณได้รับคัดเลือกเป็นผู้บัญชาการอวกาศ
                </p>

                <!-- Earned Stars Display -->
