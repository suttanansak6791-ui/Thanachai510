            // Results screen UI
            document.getElementById('res-score-lbl').textContent = t.resScore;
            document.getElementById('res-accuracy-lbl').textContent = t.resAccuracy;
            document.getElementById('res-time-lbl').textContent = t.resTime;
            document.getElementById('res-rank-lbl').textContent = t.resRank;
            document.getElementById('btn-play-again-text').textContent = t.btnPlayAgain;
            document.getElementById('summary-criteria-box').innerHTML = t.criteriaBox;

            // Re-render active stage items to update text labels
            if (!document.getElementById('screen-gameplay').classList.contains('hidden')) {
                renderCurrentStageView();
            }
        }

        // Global Drag State
        let activeDragElement = null;
        let dragData = null;
        let ghostEl = null;

        function initDragItem(element, itemData) {
            element.classList.add('draggable-item');
            
            // Pointer Down for Mouse & Touch support
            element.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                initAudio();
                
                activeDragElement = element;
                dragData = itemData;

                // Create ghost clone
                ghostEl = element.cloneNode(true);
                ghostEl.classList.add('dragging-ghost');
                ghostEl.style.width = `${element.offsetWidth}px`;
                ghostEl.style.height = `${element.offsetHeight}px`;
                document.body.appendChild(ghostEl);

                moveGhost(e.clientX, e.clientY);
                element.style.opacity = '0.4';

                window.addEventListener('pointermove', onPointerMove);
                window.addEventListener('pointerup', onPointerUp);
                playSound('click');
            });
        }

        function moveGhost(x, y) {
            if (ghostEl) {
                ghostEl.style.left = `${x - ghostEl.offsetWidth / 2}px`;
                ghostEl.style.top = `${y - ghostEl.offsetHeight / 2}px`;
            }
        }

        function onPointerMove(e) {
            if (!ghostEl) return;
            moveGhost(e.clientX, e.clientY);

            // Highlight drop targets
            const dropZone = findDropZoneUnderPointer(e.clientX, e.clientY);
            document.querySelectorAll('.drop-zone').forEach(zone => zone.classList.remove('drag-over'));
            if (dropZone) {
                dropZone.classList.add('drag-over');
            }
        }

        function onPointerUp(e) {
            window.removeEventListener('pointermove', onPointerMove);
            window.removeEventListener('pointerup', onPointerUp);

            if (ghostEl) {
                ghostEl.remove();
                ghostEl = null;
            }

            if (activeDragElement) {
                activeDragElement.style.opacity = '1';
            }

            const dropZone = findDropZoneUnderPointer(e.clientX, e.clientY);
            document.querySelectorAll('.drop-zone').forEach(zone => zone.classList.remove('drag-over'));

            if (dropZone && dragData) {
                handleDropSuccessOrFailure(dragData, dropZone);
            }

            activeDragElement = null;
            dragData = null;
        }

        function findDropZoneUnderPointer(x, y) {
            const elements = document.elementsFromPoint(x, y);
            for (let el of elements) {
                if (el.classList.contains('drop-zone') && !el.classList.contains('filled')) {
                    return el;
                }
            }
            return null;
        }

        function handleDropSuccessOrFailure(item, dropZone) {
            let isCorrect = false;

            if (currentStage === 1) {
                const targetOrder = parseInt(dropZone.dataset.orbitSlot);
                if (item.order === targetOrder) {
                    isCorrect = true;
                }
            } else if (currentStage === 2) {
                const targetCategory = dropZone.dataset.category;
                if (item.category === targetCategory) {
                    isCorrect = true;
                }
            } else if (currentStage === 3) {
                const targetId = dropZone.dataset.conceptId;
                if (item.id === targetId) {
                    isCorrect = true;
                }
            }

            if (isCorrect) {
                // Correct Drop
                playSound('correct');
                gameScore += 100;
                correctCount++;
                stageItemsCorrect++;

                updateHUD();
                renderCorrectPlacement(item, dropZone);

                // Check Stage Progression
                checkStageCompletion();
            } else {
                // Incorrect Drop
                playSound('wrong');
                wrongCount++;
                hearts--;
                updateHeartsUI();

                // Trigger Screen Shake
                document.getElementById('screen-gameplay').classList.add('shake-screen');
                setTimeout(() => {
                    document.getElementById('screen-gameplay').classList.remove('shake-screen');
                }, 400);

                if (hearts <= 0) {
                    endGame(false, 'hearts_depleted');
                }
            }
        }

        function renderCorrectPlacement(item, dropZone) {
            const t = i18n[currentLang];
            
            if (currentStage === 1) {
                dropZone.classList.add('filled', 'bg-cyan-950/80', 'border-cyan-400');
                dropZone.innerHTML = `
                    <div class="flex flex-col items-center justify-center p-1 text-center animate-pulse-glow rounded-xl w-full h-full">
                        <span class="text-2xl mb-1">${item.icon}</span>
                        <span class="text-[10px] font-bold text-cyan-200 truncate w-full">${currentLang === 'th' ? item.nameTh : item.nameEn}</span>
                        <span class="text-[9px] text-emerald-400 font-semibold">✓ #${item.order}</span>
                    </div>
                `;
                // Remove from dock
                const dockEl = document.getElementById(`planet-card-${item.id}`);
                if (dockEl) dockEl.remove();

                const remaining = 8 - stageItemsCorrect;
                document.getElementById('s1-remaining-count').textContent = t.s1Remaining.replace('{n}', remaining);
            } else if (currentStage === 2) {
                // Add to bin
                const binContainer = dropZone.querySelector('.s2-bin-items');
                const chip = document.createElement('div');
                chip.className = 'px-2.5 py-1 rounded-xl bg-gradient-to-r from-emerald-900/80 to-slate-800 border border-emerald-500/50 text-emerald-200 text-xs font-semibold flex items-center space-x-1 shadow-md';
                chip.innerHTML = `<span>${item.icon}</span> <span>${currentLang === 'th' ? item.nameTh : item.nameEn}</span> <span>✓</span>`;
                binContainer.appendChild(chip);

                const dockEl = document.getElementById(`s2-item-${item.id}`);
                if (dockEl) dockEl.remove();
            } else if (currentStage === 3) {
                dropZone.classList.add('filled', 'bg-emerald-950/60', 'border-emerald-500');
                const slotTermArea = dropZone.querySelector('.s3-matched-term');
                slotTermArea.innerHTML = `
                    <div class="px-3 py-1.5 rounded-xl bg-emerald-500/20 border border-emerald-400 text-emerald-300 font-bold text-xs flex items-center space-x-2">
                        <span>✅</span>
                        <span>${currentLang === 'th' ? item.termTh : item.termEn}</span>
                    </div>
                `;

                const dockEl = document.getElementById(`s3-term-${item.id}`);
                if (dockEl) dockEl.remove();
            }
        }

        function checkStageCompletion() {
            let requiredInStage = 0;
            if (currentStage === 1) requiredInStage = 8;
            if (currentStage === 2) requiredInStage = 9;
            if (currentStage === 3) requiredInStage = 5;

            if (stageItemsCorrect >= requiredInStage) {
                if (currentStage < 3) {
                    currentStage++;
                    stageItemsCorrect = 0;
                    setTimeout(() => {
                        renderCurrentStageView();
                        updateHUD();
                    }, 500);
                } else {
                    // All stages complete!
                    endGame(true, 'completed');
                }
            }
        }

        function renderCurrentStageView() {
            const t = i18n[currentLang];
            document.querySelectorAll('.stage-view').forEach(el => el.classList.add('hidden'));

            if (currentStage === 1) {
                document.getElementById('stage-1-view').classList.remove('hidden');
                document.getElementById('stage-badge').textContent = t.stage1Badge;
                document.getElementById('stage-title').innerHTML = `<span>🪐</span> <span>${t.stage1Title}</span>`;
                document.getElementById('stage-instruction').textContent = t.stage1Instruction;

                // Render Orbit Slots
                const slotsContainer = document.getElementById('s1-orbit-slots');
                slotsContainer.innerHTML = '';
                for (let i = 1; i <= 8; i++) {
                    const slot = document.createElement('div');
                    slot.className = 'drop-zone flex-1 min-w-[75px] h-24 rounded-2xl border-2 border-dashed border-slate-700 bg-slate-900/50 flex flex-col items-center justify-center p-1 relative transition-all';
                    slot.dataset.orbitSlot = i;
                    slot.innerHTML = `<span class="text-[10px] text-slate-500 font-orbitron font-bold">ORBIT #${i}</span>`;
                    slotsContainer.appendChild(slot);
                }

                // Render Planets Dock (Shuffled)
                const dockContainer = document.getElementById('s1-planets-dock');
                dockContainer.innerHTML = '';
                const shuffledPlanets = [...planetsData].sort(() => Math.random() - 0.5);
                shuffledPlanets.forEach(p => {
                    const planetCard = document.createElement('div');
                    planetCard.id = `planet-card-${p.id}`;
                    planetCard.className = `glass-card p-2 rounded-2xl border border-slate-600 flex flex-col items-center justify-center cursor-grab active:cursor-grabbing hover:border-cyan-400 bg-gradient-to-b ${p.color} bg-opacity-30 w-full h-20 text-center`;
                    planetCard.innerHTML = `
                        <span class="text-2xl">${p.icon}</span>
                        <span class="text-[11px] font-bold text-white mt-1 truncate max-w-full">${currentLang === 'th' ? p.nameTh : p.nameEn}</span>
                    `;
                    initDragItem(planetCard, p);
                    dockContainer.appendChild(planetCard);
                });

            } else if (currentStage === 2) {
                document.getElementById('stage-2-view').classList.remove('hidden');
                document.getElementById('stage-badge').textContent = t.stage2Badge;
                document.getElementById('stage-title').innerHTML = `<span>🌌</span> <span>${t.stage2Title}</span>`;
                document.getElementById('stage-instruction').textContent = t.stage2Instruction;

                // Clear bins
                document.getElementById('bin-star').innerHTML = '';
                document.getElementById('bin-planet').innerHTML = '';
                document.getElementById('bin-deepspace').innerHTML = '';

                // Render Shuffled Stage 2 Dock Items
                const dockContainer = document.getElementById('s2-items-dock');
                dockContainer.innerHTML = '';
                const shuffledS2 = [...classificationData].sort(() => Math.random() - 0.5);
                shuffledS2.forEach(item => {
                    const card = document.createElement('div');
                    card.id = `s2-item-${item.id}`;
                    card.className = 'glass-card px-3 py-2 rounded-xl border border-slate-600 flex items-center space-x-2 text-xs font-semibold cursor-grab hover:border-cyan-400 bg-slate-900/90';
                    card.innerHTML = `<span>${item.icon}</span><span>${currentLang === 'th' ? item.nameTh : item.nameEn}</span>`;
                    initDragItem(card, item);
                    dockContainer.appendChild(card);
                });

            } else if (currentStage === 3) {
                document.getElementById('stage-3-view').classList.remove('hidden');
                document.getElementById('stage-badge').textContent = t.stage3Badge;
                document.getElementById('stage-title').innerHTML = `<span>🧩</span> <span>${t.stage3Title}</span>`;
                document.getElementById('stage-instruction').textContent = t.stage3Instruction;

                // Render Target Concept Slots
                const targetContainer = document.getElementById('s3-target-slots');
                targetContainer.innerHTML = '';
                conceptData.forEach(c => {
                    const slot = document.createElement('div');
                    slot.className = 'drop-zone p-3 rounded-2xl bg-slate-950/80 border-2 border-dashed border-slate-700 flex flex-col justify-between space-y-2';
                    slot.dataset.conceptId = c.id;
                    slot.innerHTML = `
                        <p class="text-xs text-slate-200 leading-relaxed">
                            💡 ${currentLang === 'th' ? c.descTh : c.descEn}
                        </p>
                        <div class="s3-matched-term flex justify-end">
                            <span class="text-[10px] text-slate-500 italic">ลากคำศัพท์มาวางที่นี่</span>
                        </div>
                    `;
                    targetContainer.appendChild(slot);
                });

                // Render Shuffled Terms Dock
                const termsContainer = document.getElementById('s3-terms-dock');
                termsContainer.innerHTML = '';
                const shuffledTerms = [...conceptData].sort(() => Math.random() - 0.5);
                shuffledTerms.forEach(item => {
                    const termCard = document.createElement('div');
                    termCard.id = `s3-term-${item.id}`;
                    termCard.className = 'glass-card px-3 py-2 rounded-xl bg-gradient-to-r from-purple-900/60 to-slate-900 border border-purple-500/40 text-purple-200 font-bold text-xs cursor-grab hover:border-cyan-300';
                    termCard.textContent = currentLang === 'th' ? item.termTh : item.termEn;
                    initDragItem(termCard, item);
                    termsContainer.appendChild(termCard);
                });
            }
        }

        function startGame() {
            initAudio();
            gameScore = 0;
            hearts = 3;
            timerSeconds = 60;
            currentStage = 1;
            correctCount = 0;
            wrongCount = 0;
            stageItemsCorrect = 0;

            document.getElementById('screen-start').classList.add('hidden');
            document.getElementById('screen-summary').classList.add('hidden');
            document.getElementById('screen-gameplay').classList.remove('hidden');
            document.getElementById('game-hud').classList.remove('hidden');

            updateHeartsUI();
            updateHUD();
            renderCurrentStageView();
            updateLanguageUI();

            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timerSeconds--;
                updateHUD();
                if (timerSeconds <= 0) {
                    endGame(false, 'time_out');
                }
            }, 1000);

            playSound('click');
        }

        function restartCurrentGame() {
            if (confirm('คุณต้องการเริ่มเกมใหม่หรือไม่? / Restart game?')) {
                startGame();
            }
        }

        function updateHUD() {
            document.getElementById('hud-timer').textContent = `${timerSeconds}s`;
            document.getElementById('hud-score').textContent = gameScore;
            document.getElementById('hud-stage-num').textContent = `${currentStage} / 3`;

            // Progress bar
            const totalProgress = ((correctCount) / totalTotalItems) * 100;
            document.getElementById('hud-progress-bar').style.width = `${Math.min(100, totalProgress)}%`;

            // Timer alert color
            if (timerSeconds <= 15) {
                document.getElementById('hud-timer').classList.add('text-rose-500', 'animate-pulse');
            } else {
                document.getElementById('hud-timer').classList.remove('text-rose-500', 'animate-pulse');
            }
        }

        function updateHeartsUI() {
            const container = document.getElementById('hearts-container');
            const heartCells = container.querySelectorAll('.heart-cell');
            heartCells.forEach((cell, idx) => {
                if (idx < hearts) {
                    cell.classList.remove('lost');
                } else {
                    cell.classList.add('lost');
                }
            });
        }

        function endGame(isSuccess, reason) {
            if (timerInterval) clearInterval(timerInterval);

            // Calculate Metrics
            const timeElapsed = 60 - timerSeconds;
            const accuracy = Math.round((correctCount / totalTotalItems) * 100);
            
            // Win condition: Accuracy >= 80% and Hearts >= 1 and completed/within time
            const isWin = isSuccess || (accuracy >= 80 && hearts >= 1);

            // Time & Heart Bonus
            if (isWin) {
                gameScore += (timerSeconds * 15) + (hearts * 100);
            }

            // High Score Check
            if (gameScore > highScore) {
                highScore = gameScore;
                localStorage.setItem('space_game_highscore', highScore);
            }
            document.getElementById('hud-high-score').textContent = highScore;

            // Render Results Screen
            document.getElementById('screen-gameplay').classList.add('hidden');
            document.getElementById('game-hud').classList.add('hidden');
            document.getElementById('screen-summary').classList.remove('hidden');

            const t = i18n[currentLang];
            const iconWrapper = document.getElementById('summary-icon-wrapper');
            const titleEl = document.getElementById('summary-status-title');
            const subtitleEl = document.getElementById('summary-status-subtitle');
            const starsContainer = document.getElementById('summary-stars');

            if (isWin) {
                playSound('victory');
                iconWrapper.className = 'w-20 h-20 rounded-3xl bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-4xl shadow-xl mb-3 animate-bounce';
                iconWrapper.textContent = '🏆';
                titleEl.textContent = t.winTitle;
                titleEl.className = 'text-2xl md:text-3xl font-extrabold font-orbitron text-emerald-400 mb-1';
                subtitleEl.textContent = t.winSubtitle;

                // Calculate Star Rating
                let starCount = 1;
                if (accuracy >= 90 && hearts === 3) starCount = 3;
                else if (accuracy >= 80) starCount = 2;

                starsContainer.innerHTML = Array(starCount).fill('<span class="text-amber-400">⭐</span>').join('');

                // Rank Title
                let rank = t.ranks.cadet;
                if (starCount === 3) rank = t.ranks.commander;
                else if (starCount === 2) rank = t.ranks.navigator;
                document.getElementById('res-rank-val').textContent = rank;

            } else {
                playSound('gameover');
                iconWrapper.className = 'w-20 h-20 rounded-3xl bg-gradient-to-br from-rose-500 to-red-700 flex items-center justify-center text-4xl shadow-xl mb-3';
                iconWrapper.textContent = '💥';
                titleEl.textContent = t.loseTitle;
                titleEl.className = 'text-2xl md:text-3xl font-extrabold font-orbitron text-rose-500 mb-1';
                subtitleEl.textContent = t.loseSubtitle;
                starsContainer.innerHTML = '<span class="text-slate-600 text-xl">❌ FAIL</span>';
                document.getElementById('res-rank-val').textContent = 'Cadet (Unassigned)';
            }

            document.getElementById('res-score-val').textContent = gameScore;
            document.getElementById('res-accuracy-val').textContent = `${accuracy}%`;
            document.getElementById('res-time-val').textContent = `${timeElapsed}s`;
        }

        function initStarryCanvas() {
            const canvas = document.getElementById('space-bg');
            const ctx = canvas.getContext('2d');
            let width = (canvas.width = window.innerWidth);
            let height = (canvas.height = window.innerHeight);

            window.addEventListener('resize', () => {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            });

            const stars = Array.from({ length: 120 }, () => ({
                x: Math.random() * width,
                y: Math.random() * height,
                radius: Math.random() * 1.5 + 0.5,
                alpha: Math.random(),
                speed: Math.random() * 0.02 + 0.005
            }));

            function draw() {
                ctx.clearRect(0, 0, width, height);

                // Draw gradient dark cosmic backdrop
                const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
                bgGrad.addColorStop(0, '#030712');
                bgGrad.addColorStop(0.5, '#0b132b');
                bgGrad.addColorStop(1, '#030712');
                ctx.fillStyle = bgGrad;
                ctx.fillRect(0, 0, width, height);

                // Render twinkling stars
                stars.forEach(star => {
                    star.alpha += star.speed;
                    if (star.alpha > 1 || star.alpha < 0) {
                        star.speed = -star.speed;
                    }
                    ctx.beginPath();
                    ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(255, 255, 255, ${Math.abs(star.alpha)})`;
                    ctx.fill();
                });

                requestAnimationFrame(draw);
            }

            draw();
        }

        window.onload = function () {
            initStarryCanvas();
            document.getElementById('hud-high-score').textContent = highScore;
            document.getElementById('sound-icon').textContent = isSoundMuted ? '🔇' : '🔊';
            updateLanguageUI();
        };
    </script>
</body>
